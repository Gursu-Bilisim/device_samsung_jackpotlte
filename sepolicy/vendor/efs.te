# /efs is a link to /mnt/vendor/efs (BOARD_ROOT_EXTRA_SYMLINKS) labeled
# efs_file. The CUK6 blobs open their files through it; without lnk_file read
# cbd gets EACCES on /efs/nv_data.bin (not audited) and the modem never boots.
allow { cbd rild tee } efs_file:lnk_file read;

# mcDriverDaemon keeps the Trustonic secure storage (/efs/TEE/Store_1.tf,
# gk_context_*) in EFS and opens it read-write; the SLSI policy only grants
# read on efs_file and no search on /mnt/vendor. Without this every trustlet
# session (gatekeeper, fingerprint) fails and no lock screen credential can
# be enrolled.
allow tee mnt_vendor_file:dir { getattr search };
allow tee efs_file:dir rw_dir_perms;
allow tee efs_file:file create_file_perms;

# The Trustonic gatekeeper HAL (TlcTeeGatekeeper) keeps its context files
# next to the TEE storage (/efs/TEE/gk_context_*) and opens them itself.
allow hal_gatekeeper_default mnt_vendor_file:dir { getattr search };
allow hal_gatekeeper_default efs_file:lnk_file read;
allow hal_gatekeeper_default efs_file:dir rw_dir_perms;
allow hal_gatekeeper_default efs_file:file create_file_perms;
