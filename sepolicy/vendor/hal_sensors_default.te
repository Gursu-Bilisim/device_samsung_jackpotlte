# The sensor HAL finds each sensor by reading /sys/bus/iio/devices/*/name and
# sets up its buffer through buffer/length and buffer/enable before reading
# /dev/iio:deviceN. The denials are not logged; without these every sensor
# reports "data fd -1" and no events arrive.
allow hal_sensors_default sysfs_iio:dir r_dir_perms;
allow hal_sensors_default sysfs_iio:file rw_file_perms;
