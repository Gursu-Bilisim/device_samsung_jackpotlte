soong_namespace {
}

// The bootloader passes androidboot.hardware=samsungexynos7885, so init
// looks for fstab.samsungexynos7885 and init.samsungexynos7885.rc.
// Module names follow TARGET_SOC (exynos7885) as in exynos7885-common.

prebuilt_etc {
    name: "fstab.exynos7885",
    src: "rootdir/etc/fstab.samsungexynos7885",
    filename: "fstab.samsungexynos7885",
    vendor: true,
}

prebuilt_etc {
    name: "init.exynos7885.rc",
    src: "rootdir/etc/init.samsungexynos7885.rc",
    filename: "init.samsungexynos7885.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "init.exynos7885.usb.rc",
    src: "rootdir/etc/init.samsungexynos7885.usb.rc",
    filename: "init.samsungexynos7885.usb.rc",
    sub_dir: "init/hw",
    vendor: true,
}

prebuilt_etc {
    name: "ueventd.jackpotlte.rc",
    src: "rootdir/etc/ueventd.rc",
    filename: "ueventd.rc",
    vendor: true,
}

// sensors.universal7885.so (CUK6) links android.frameworks.schedulerservice@1.0,
// a VNDK-core library in Android 9 that AOSP no longer builds. This is the
// AOSP VNDK v28 prebuilt (prebuilts/vndk/v28/arm64/arch-arm64-armv8-a). The
// sensors service is 64-bit only, so the 32-bit copy is not installed.
// The prebuilt's libhidltransport.so dependency is renamed to
// libhidlbase_shim.so (hardware/lineage/compat), which exports the
// gBnConstructorMap/gBsConstructorMap globals that Android 9 generated HIDL
// code registers into and that libhidlbase no longer has.
cc_prebuilt_library_shared {
    name: "android.frameworks.schedulerservice@1.0-vndk28",
    stem: "android.frameworks.schedulerservice@1.0",
    vendor: true,
    compile_multilib: "64",
    check_elf_files: false,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["prebuilts/vndk-28/arm64/android.frameworks.schedulerservice@1.0.so"],
        },
    },
}
